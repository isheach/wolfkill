<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>KsgGodot</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The Godot editor writes generated C# and test-project files below the
       project directory. Keep those files out of the main game's compile
       glob so a standalone `dotnet build` remains reproducible. -->
  <ItemGroup>
    <Compile Remove=".godot\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>
</Project>
